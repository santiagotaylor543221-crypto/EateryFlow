# PostgreSQL / Supabase Database Connection
# Pooled connection string (Session/Transaction pooler - port 6543 on Supabase)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection string for Prisma CLI / migrations (port 5432 on Supabase)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Authentication (jose JWT)
JWT_SECRET="your-super-secret-jwt-key-with-at-least-32-characters"

# Google Gemini AI Integration
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.0-flash"

# Automation with n8n Webhook
N8N_WEBHOOK_URL="https://your-n8n-instance.com/webhook/eateryflow-events"

# Environment
NODE_ENV="development"
